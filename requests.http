@host = http://localhost:3000

GET {{host}}/

GET {{host}}/api/info

POST {{host}}/api/test
Content-Type: application/json

{
  "name": "Ноутбук",
  "price": 2500
}

POST {{host}}/api/flights
Content-Type: application/json

{
  "flightNumber": "AV-606",
  "departure": "Минск",
  "arrival": "Прага",
  "price": 300,
  "isAvailable": true,
  "description": "Регулярный рейс по средам"
}

PUT {{host}}/api/flights/5
Content-Type: application/json

{
  "flightNumber": "AV-505-NEW",
  "departure": "Минск",
  "arrival": "Вена",
  "price": 350,
  "isAvailable": true,
  "description": "Обновлённое описание"
}

### POST с пустыми полями
POST {{host}}/api/flights
Content-Type: application/json

{
  "flightNumber": "",
  "departure": "Минск",
  "arrival": "Прага",
  "price": 300,
  "isAvailable": true
}

### POST с отрицательной ценой
POST {{host}}/api/flights
Content-Type: application/json

{
  "flightNumber": "AV-000",
  "departure": "Минск",
  "arrival": "Прага",
  "price": -100,
  "isAvailable": true
}

### POST без price
POST {{host}}/api/flights
Content-Type: application/json

{
  "flightNumber": "AV-000",
  "departure": "Минск",
  "arrival": "Прага"
}
